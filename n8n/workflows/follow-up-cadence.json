{
  "name": "Orbit - Follow-up Cadence",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 30 }] }
      },
      "id": "cron15m",
      "name": "Every 30 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8100/api/outreach/process-cadence",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{$env.ORBIT_SERVICE_TOKEN}}"}
          ]
        }
      },
      "id": "cadence",
      "name": "Process approved sends",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            { "leftValue": "={{$json.failed}}", "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check_failed",
      "name": "Failures?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8100/api/health",
        "options": {}
      },
      "id": "log_failures",
      "name": "Note failures (API logs)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 100],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every 30 minutes": { "main": [[{ "node": "Process approved sends", "type": "main", "index": 0 }]] },
    "Process approved sends": { "main": [[{ "node": "Failures?", "type": "main", "index": 0 }]] },
    "Failures?": { "main": [[{ "node": "Note failures (API logs)", "type": "main", "index": 0 }], null] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "description": "Sends approved messages whose scheduled time arrived; idempotency enforced by the API. Dead-lettered messages surface as failed counts." }
}
