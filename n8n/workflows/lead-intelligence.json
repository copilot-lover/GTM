  {
   "parameters": {
    "triggerMode": "listenTrigger",
    "channelName": "orbit_events",
    "options": {}
   },
   "id": "trg1",
   "name": "Event Listener (LISTEN orbit_events)",
   "type": "n8n-nodes-base.postgresTrigger",
   "typeVersion": 1.1,
   "position": [
    0,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "// LISTEN payload is 'event_type|event_id'\nconst raw = String($json.payload || $json.data || '');\nconst [event_type, event_id] = raw.split('|');\nreturn { event_type, event_id };"
   },
   "id": "norm0",
   "name": "On NOTIFY",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    300
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "=http://127.0.0.1:8100/api/pipeline/events/{{ $json.event_id }}",
    "sendHeaders": true,
    "headerParameters": {
     "parameters": [
      {
       "name": "Authorization",
       "value": "={{$env.ORBIT_SERVICE_TOKEN}}"
      }
     ]
    }
   },
   "id": "fetch1",
   "name": "Fetch Event Row",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    440,
    300
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 5000
  },
  {
   "parameters": {
    "fieldToSplitOut": "items",
    "options": {}
   },
   "id": "split1",
   "name": "Split Events",
   "type": "n8n-nodes-base.splitOut",
   "typeVersion": 1,
   "position": [
    660,
    300
   ]
  },
  {
   "parameters": {
    "jsCode": "const e = Array.isArray($json.items) ? $json.items[0] : $json;\nconst payload = typeof e.payload === 'string' ? JSON.parse(e.payload) : (e.payload || {});\nreturn { lead_id: payload.lead_id, event_type: e.event_type, event_id: e.id, payload };"
   },
   "id": "norm1",
   "name": "Normalize Event",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    300
   ]
  },
  {
   "parameters": {
    "dataType": "string",
    "value1": "={{$json.event_type}}",
    "rules": {
     "rules": [
      {
       "value2": "lead.qualification_requested",
       "output": 0
      },
      {
       "value2": "lead.enrichment_requested",
       "output": 1
      },
      {
       "value2": "lead.audit_requested",
       "output": 2
      },
      {
       "value2": "lead.offer_requested",
       "output": 3
      },
      {
       "value2": "lead.draft_requested",
       "output": 4
      }
     ]
    },
    "options": {}
   },
