# Orbit GTM OS — environment template.
# Copy to .env (dev) or .env.prod (prod) and fill in real values.
# NEVER commit real .env files.

# --- Runtime ---
ORBIT_ENV=dev                    # dev | prod
APP_HOST=127.0.0.1
APP_PORT=8100

# --- Database ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=change-me

# --- Auth ---
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_MINUTES=10080

# --- Scraping (Scrapling) ---
SCRAPER_HEADLESS=true
SCRAPER_STEALTH_MODE=true

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Orbit

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=

# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- In-app provider layer (supersedes n8n for external calls) ---
# OpenRouter chat-completion key. Accepted as either var name:
LLM_API_KEY=
OPENROUTER_API_KEY=
# Ordered comma-separated model fallback chain (first success wins):
# cheap tier starts at the first model; strong tier honors LLM_STRONG_MODEL
# if set (else first model); frontier tier starts at the last model.
LLM_MODEL_CHAIN=zencode/ox-alpha,nvidia/llama-3.1-nemotron-ultra-253b-v1:free,zencode/nemotron-ultra-3
LLM_STRONG_MODEL=

# --- In-process background workers ---
# Run worker pools inside the API process. Keep false for multi-worker
# uvicorn/gunicorn setups; enable on a single dedicated process.
WORKERS_ENABLED=false
# {pool: concurrency} — pools: discovery, enrichment, verification, ai, outbound, meeting
WORKER_POOLS_JSON={"ai":2,"enrichment":2,"verification":2,"outbound":2,"discovery":1,"meeting":1}
# Optional per-provider in-flight caps, e.g. {"openrouter":4}
PROVIDER_CONCURRENCY_JSON={}

# Fernet key material used to encrypt secrets at rest (telegram bot token).
APP_SECRET=

# --- Provider API keys (documented; unused until each integration ships) ---
JOBSPIPE_API_KEY=
THEIRSTACK_API_KEY=
JSEARCH_API_KEY=
FANTASTIC_JOBS_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=

# --- Telegram notifications (encrypted at rest via APP_SECRET) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- n8n ---
N8N_HOST=127.0.0.1
N8N_PORT=5678
N8N_WEBHOOK_SECRET=

# --- AI budget guardrails ---
AI_DAILY_BUDGET_USD=10

# --- CAN-SPAM ---
ORBIT_PHYSICAL_ADDRESS=123 Main St, City, ST 00000
