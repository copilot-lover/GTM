# Orbit GTM OS — environment template.
# Copy to .env (dev) or .env.prod (prod) and fill in real values.
# NEVER commit real .env files.

# --- Runtime ---
ORBIT_ENV=dev                    # dev | prod
APP_HOST=127.0.0.1
APP_PORT=8100

# --- Database ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=change-me

# --- Auth ---
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_MINUTES=10080

# --- Scraping (Scrapling) ---
SCRAPER_HEADLESS=true
SCRAPER_STEALTH_MODE=true

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Orbit

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=

# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- n8n ---
N8N_HOST=127.0.0.1
N8N_PORT=5678
N8N_WEBHOOK_SECRET=

# --- AI budget guardrails ---
AI_DAILY_BUDGET_USD=10

# --- CAN-SPAM ---
ORBIT_PHYSICAL_ADDRESS=123 Main St, City, ST 00000
